# CodePractice Muhit Sozlamalari (Environment Variables)

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Ma'lumotlar bazasi (PostgreSQL)
DATABASE_URL=postgresql://codepractice_user:codepractice_password@localhost:5432/codepractice?schema=public

# JWT Autentifikatsiya
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Desktop Ilova Chiqish Ruxsat Kodi (Exit Pin)
EXIT_ACCESS_CODE=4826

# AI Konfiguratsiyasi (Server-side Gemini yoki OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_DAILY_LIMIT_PER_STUDENT=30

# Web Panel URL (CORS uchun)
WEB_APP_URL=http://localhost:3000
DESKTOP_APP_ORIGIN=tauri://localhost

# AWS Konfiguratsiyasi (Production uchun)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=codepractice-storage

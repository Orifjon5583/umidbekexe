{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@codepractice/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@codepractice/validation": ["../../packages/validation/src/index.ts"],
      "@codepractice/api-client": ["../../packages/api-client/src/index.ts"]
    },
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*"]
}
